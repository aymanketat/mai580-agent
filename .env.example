# Copy this file to .env and fill in your key. Never commit .env.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1-mini

# Live data sources (the tools work offline from data/ when both are 0). Values: 1/true/yes or 0.
# ARXIV_LIVE=1 lets search_papers / get_paper / format_citation / check_citation query the arXiv
#   API for papers that are not in data/papers.json (3 s between requests). Default 0: catalogue only.
ARXIV_LIVE=0
# S2_LIVE (default 1 when unset) lets get_citation_count query Semantic Scholar (unauthenticated,
#   rate-limited). Successful responses are cached on disk in data/cache/semantic_scholar/
#   (gitignored) with their retrieval time; a cached value is reused for S2_CACHE_TTL_HOURS (hours;
#   unreadable values fall back to 168), then refreshed when the API answers, otherwise returned
#   marked stale. With S2_LIVE=0 only the cache and the committed snapshot
#   data/citations_snapshot.json are used.
S2_LIVE=1
S2_CACHE_TTL_HOURS=168

# Note: the model calls (run.py, the agent nodes, the `live` tests) always need OPENAI_API_KEY;
# the data tools and the offline tests do not.

# Stage 12: LangSmith tracing (free developer account)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=mai580-agent
